//@version=6
indicator(
     "GAL PRO V7",
     shorttitle = "GAL PRO V7",
     overlay = true,
     max_labels_count = 500,
     max_lines_count = 500)

//==================================================
// GAL PRO V7
// PART / MODULE 1 - FOUNDATION
//==================================================

//==============================
// INPUTS
//==============================

emaLength   = input.int(21, "EMA Length", minval = 1)
maxWaitBars = input.int(10, "Maximum Breakout Bars", minval = 1)

showEMA   = input.bool(true, "Show EMA")
showDebug = input.bool(true, "Developer Dashboard")

//==============================
// EMA ENGINE
//==============================

ema21 = ta.ema(close, emaLength)

plot(
    showEMA ? ema21 : na,
    color = color.yellow,
    linewidth = 2,
    title = "EMA 21")

//==================================================
// ENGINE STATES
//==================================================

STATE_IDLE          = 0
STATE_WAIT_CONFIRM  = 1
STATE_WAIT_BREAKOUT = 2
STATE_TRADE_ACTIVE  = 3

//==================================================
// ENGINE MEMORY
//==================================================

var int state = STATE_IDLE

var bool isBuy = true

var bool tradeActive = false

//----------------------------
// M02 Cross + Confirmation
//
//Cross
//----------------------------

var int crossBar = na

var float crossHigh = na
var float crossLow  = na

//----------------------------
// Confirmation
//----------------------------

var int confirmBar = na

var float confirmHigh = na
var float confirmLow  = na

//----------------------------
// Breakout Event M03 
//----------------------------

var bool breakoutTriggered = false

var int breakoutBar = na

var float breakoutPrice = na

//----------------------------
// Trade
//----------------------------

var float entryPrice = na

var float stopLoss = na

//----------------------------
// Waiting
//----------------------------

var int waitBars = 0

//----------------------------
// Drawing
//----------------------------

var line entryLine = na
var line stopLine = na

var label buyLabel = na
var label sellLabel = na
var label exitLabel = na

//==================================================
// SIGNAL EVENTS
//==================================================

var bool newBuySignal = false
var bool newSellSignal = false

//==================================================
// RESET ENGINE
//==================================================
var bool doReset = false
if doReset
    state := STATE_IDLE

    tradeActive := false

    breakoutTriggered := false

    newBuySignal := false
    newSellSignal := false

    crossBar := na
    confirmBar := na
    breakoutBar := na

    crossHigh := na
    crossLow := na

    confirmHigh := na
    confirmLow := na

    breakoutPrice := na

    entryPrice := na
    stopLoss := na

    waitBars := 0

    if not na(entryLine)
        line.delete(entryLine)

    if not na(stopLine)
        line.delete(stopLine)

    entryLine := na
    stopLine := na

    doReset := false
    //==================================================
// CROSS ENGINE
//==================================================

// Detect only while idle
buyCross =
     state == STATE_IDLE and
     open < ema21 and
     close > ema21

sellCross =
     state == STATE_IDLE and
     open > ema21 and
     close < ema21

//--------------------------------------------------
// BUY CROSS
//--------------------------------------------------

if buyCross

    isBuy := true

    crossBar := bar_index
    crossHigh := high
    crossLow := low

    stopLoss := low

    waitBars := 0

    state := STATE_WAIT_CONFIRM

//--------------------------------------------------
// SELL CROSS
//--------------------------------------------------

if sellCross

    isBuy := false

    crossBar := bar_index
    crossHigh := high
    crossLow := low

    stopLoss := high

    waitBars := 0

    state := STATE_WAIT_CONFIRM

//==================================================
// CONFIRMATION ENGINE
//==================================================

if state == STATE_WAIT_CONFIRM

    // Must be immediate next candle only
    if bar_index == crossBar + 1

        buyConfirm =
             isBuy and
             low > ema21

        sellConfirm =
             (not isBuy) and
             high < ema21

        if buyConfirm

            confirmBar := bar_index
            confirmHigh := high
            confirmLow := low

            state := STATE_WAIT_BREAKOUT

        else if sellConfirm

            confirmBar := bar_index
            confirmHigh := high
            confirmLow := low

            state := STATE_WAIT_BREAKOUT

        else

            doReset := true

    else if bar_index > crossBar + 1

        doReset := true


        
    
//==================================================
// BREAKOUT ENGINE (M03)
//==================================================


if state == STATE_WAIT_BREAKOUT

    // Cancel setup if EMA is violated
    if (isBuy and low <= ema21) or ((not isBuy) and high >= ema21)

        doReset := true

    else

        // BUY BREAKOUT
        if isBuy and high > confirmHigh and low > ema21

            breakoutTriggered := true
            breakoutBar := bar_index
            breakoutPrice := confirmHigh

            entryPrice := confirmHigh
            stopLoss := confirmLow

            newBuySignal := true

            tradeActive := true

            state := STATE_TRADE_ACTIVE

        // SELL BREAKOUT
        if (not isBuy) and low < confirmLow and high < ema21

            breakoutTriggered := true
            breakoutBar := bar_index
            breakoutPrice := confirmLow

            entryPrice := confirmLow
            stopLoss := confirmHigh

            newSellSignal := true

            tradeActive := true

            state := STATE_TRADE_ACTIVE

        // Wait counter
        waitBars += 1

        if waitBars > maxWaitBars
            doReset := true


//==================================================
// M04 - BUY / SELL RENDERER
//==================================================

//----------------------------
// BUY LABEL
//----------------------------
if newBuySignal

    buyLabel := label.new(
         bar_index,
         low,
         "BUY",
         yloc = yloc.belowbar,
         style = label.style_label_up,
         color = color.green,
         textcolor = color.white,
         size = size.small)

    // One-shot event
    newBuySignal := false

//----------------------------
// SELL LABEL
//----------------------------
if newSellSignal

    sellLabel := label.new(
         bar_index,
         high,
         "SELL",
         yloc = yloc.abovebar,
         style = label.style_label_down,
         color = color.red,
         textcolor = color.white,
         size = size.small)

    // One-shot event
    newSellSignal := false

        //==================================================
// DEBUG DASHBOARD
//==================================================

if showDebug

    var table dbg = table.new(position.top_right, 2, 10)

    if barstate.islast

        table.cell(dbg,0,0,"GAL PRO V7")
        table.cell(dbg,1,0,"CORE")

        table.cell(dbg,0,1,"State")
        table.cell(dbg,1,1,str.tostring(state))

        table.cell(dbg,0,2,"Direction")
        table.cell(dbg,1,2,isBuy ? "BUY" : "SELL")

        table.cell(dbg,0,3,"Cross")
        table.cell(dbg,1,3,str.tostring(crossBar))

        table.cell(dbg,0,4,"Confirm")
        table.cell(dbg,1,4,str.tostring(confirmBar))

        table.cell(dbg,0,5,"Breakout")
        table.cell(dbg,1,5,str.tostring(breakoutBar))

        table.cell(dbg,0,6,"Trade")
        table.cell(dbg,1,6,str.tostring(tradeActive))

        table.cell(dbg,0,7,"Entry")
        table.cell(dbg,1,7,str.tostring(entryPrice))

        table.cell(dbg,0,8,"SL")
        table.cell(dbg,1,8,str.tostring(stopLoss))

        table.cell(dbg,0,9,"Wait")
        table.cell(dbg,1,9,str.tostring(waitBars))


